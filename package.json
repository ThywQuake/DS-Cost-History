{
  "name": "dsh-deepseek-usage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin: export DeepSeek platform consumption records with a Paid/Granted split from a browser HAR and Bearer token.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "usage",
    "billing",
    "export"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThywQuake/DS-Cost-History.git"
  }
}
